EXTERNAL_DOMAIN=ntduc.org
TAILSCALE_DOMAIN=ts.ntduc.org
TZ=Asia/Singapore
# Generate:
#   echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-change-this-long-random-secret
LITELLM_LOG=ERROR
OPENROUTER_API_KEY=sk-something-change-this-to-actual-api-key

# Onyx replaces Open WebUI on ai.${TAILSCALE_DOMAIN} / ai.${EXTERNAL_DOMAIN}
ONYX_IMAGE_TAG=latest
ONYX_AUTH_TYPE=basic
# Generate: openssl rand -hex 32
ONYX_USER_AUTH_SECRET=change-this-long-random-secret
ONYX_POSTGRES_USER=postgres
# Generate: openssl rand -hex 32
ONYX_POSTGRES_PASSWORD=change-this-postgres-password
ONYX_POSTGRES_DB=postgres
# Must satisfy OpenSearch's strong password rules.
ONYX_OPENSEARCH_ADMIN_PASSWORD=ChangeThisStrongPassword123!
ONYX_OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
ONYX_LOG_LEVEL=info
ONYX_DISABLE_TELEMETRY=true
