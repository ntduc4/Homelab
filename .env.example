# Docker Compose Manager filters for ./dcm.sh.
# Values can be comma or space separated. Empty include means all stacks.
# Empty exclude means no exclusions. If a stack is in both, exclude wins.

# On the AI machine:
# DCM_INCLUDE=ai
# DCM_EXCLUDE=

# On the GMKtec, run everything except AI:
# DCM_INCLUDE=
# DCM_EXCLUDE=ai

DCM_INCLUDE=
DCM_EXCLUDE=
# NAS media mount used by Arr, Jellyfin, Books, and Homepage.
NAS_IP=your-nas-ip
NAS_MEDIA_EXPORT=/path/to/nas/export
NAS_MEDIA_MOUNT=/path/to/local/mount
